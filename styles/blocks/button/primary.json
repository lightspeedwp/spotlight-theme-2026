{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Primary",
	"slug": "primary",
	"blockTypes": ["core/button"],
	"description": "Full-pill call-to-action button with an accent-blue fill and a trailing arrow, used for dashboard/CTA links.",
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--accent-200)",
			"text": "var(--wp--preset--color--base)"
		},
		"border": {
			"radius": "var(--wp--preset--border-radius--500)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--20)",
				"right": "var(--wp--preset--spacing--30)",
				"bottom": "var(--wp--preset--spacing--20)",
				"left": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--200)",
			"fontWeight": "var:custom|font-weight|semi-bold"
		},
		":hover": {
			"color": {
				"background": "var(--wp--preset--color--accent-300)",
				"text": "var(--wp--preset--color--base)"
			}
		},
		"css": "&::after { content: \"\\2192\"; margin-inline-start: var(--wp--preset--spacing--5); }"
	}
}
