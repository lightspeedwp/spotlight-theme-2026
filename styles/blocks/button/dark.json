{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"slug": "dark",
	"blockTypes": ["core/button"],
	"description": "Navy-filled rounded-rect button with a leading icon, used for actions like Republish Article. Darkens to accent-600 on hover.",
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--accent-500)",
			"text": "var(--wp--preset--color--base)"
		},
		"border": {
			"radius": "var(--wp--preset--border-radius--200)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--20)",
				"right": "var(--wp--preset--spacing--30)",
				"bottom": "var(--wp--preset--spacing--20)",
				"left": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--200)",
			"fontWeight": "var:custom|font-weight|semi-bold"
		},
		":hover": {
			"color": {
				"background": "var(--wp--preset--color--accent-600)",
				"text": "var(--wp--preset--color--base)"
			}
		},
		"css": "&::before { content: \"\\2197\"; margin-inline-end: var(--wp--preset--spacing--5); }"
	}
}
