{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dashboard",
	"slug": "dashboard",
	"blockTypes": ["core/button"],
	"description": "Full-pill navy-filled button, used for the header navigation Dashboard CTA. Darkens to accent-600 on hover.",
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--accent-500)",
			"text": "var(--wp--preset--color--base)"
		},
		"border": {
			"radius": "var(--wp--preset--border-radius--500)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--20)",
				"right": "var(--wp--preset--spacing--30)",
				"bottom": "var(--wp--preset--spacing--20)",
				"left": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--200)",
			"fontWeight": "var:custom|font-weight|semi-bold"
		}
	}
}
