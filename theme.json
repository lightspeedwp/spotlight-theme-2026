				},
				{
					"name": "XXXXL",
					"slug": "80",
					"size": "clamp(3rem, calc(0.217rem + 5.797vw), 5rem)"
				},
				{
					"name": "Gigantic",
					"slug": "90",
					"size": "clamp(3.5rem, calc(0.544rem + 6.159vw), 5.625rem)"
				},
				{
					"name": "Colossal",
					"slug": "100",
					"size": "clamp(4rem, calc(0.87rem + 6.522vw), 6.25rem)"
				}
			],
			"units": ["%", "em", "px", "rem", "vh", "vw"]
