					"slug": "40",
					"size": "clamp(1.625rem, calc(0.408rem + 2.536vw), 2.5rem)"
				},
				{
					"name": "XL",
					"slug": "50",
					"size": "clamp(2.063rem, calc(0.584rem + 3.08vw), 3.125rem)"
				},
				{
					"name": "XXL",
					"slug": "60",
					"size": "clamp(2.313rem, calc(0.313rem + 4.167vw), 3.75rem)"
				},
				{
					"name": "XXXL",
					"slug": "70",
