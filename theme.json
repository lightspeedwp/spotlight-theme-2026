		"spacing": {
			"spacingSizes": [
				{
					"name": "XXS",
					"slug": "5",
					"size": "clamp(0.25rem, calc(0.163rem + 0.181vw), 0.313rem)"
				},
				{
					"name": "XS",
					"slug": "10",
					"size": "clamp(0.5rem, calc(0.326rem + 0.362vw), 0.625rem)"
				},
				{
					"name": "S",
					"slug": "20",
					"size": "clamp(0.875rem, calc(0.353rem + 1.087vw), 1.25rem)"
				},
