		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Libre Baskerville\", serif",
					"name": "Libre Baskerville",
					"slug": "heading",
					"fontFace": [
						{
							"fontFamily": "Libre Baskerville",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/libre-baskerville/LibreBaskerville-variable-latin.woff2"]
						},
