		"custom": {
			"fontWeight": {
				"thin": 100,
				"extra-light": 200,
				"light": 300,
				"regular": 400,
				"medium": 500,
				"semi-bold": 600,
				"bold": 700,
				"extra-bold": 800,
				"black": 900
			},
			"lineHeight": {
				"heading": "1.25",
				"body": "1.5"
			},
			"borderWidth": {
				"none": "0",
				"base": "1px",
				"small": "2px",
				"medium": "4px",
				"large": "8px"
			}
		},
		"blocks": {}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body, system-ui, sans-serif)",
			"fontSize": "var(--wp--preset--font-size--200)",
			"fontWeight": "var:custom|font-weight|regular",
			"lineHeight": "var:custom|line-height|body"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-200)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-300)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "var:custom|line-height|heading"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--800)",
					"fontWeight": "var:custom|font-weight|bold"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--700)",
					"fontWeight": "var:custom|font-weight|semi-bold"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--600)",
					"fontWeight": "var:custom|font-weight|semi-bold"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--400)",
					"fontWeight": "var:custom|font-weight|semi-bold"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--300)",
					"fontWeight": "var:custom|font-weight|semi-bold"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--300)",
					"fontWeight": "var:custom|font-weight|bold",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--200)",
					"fontWeight": "var:custom|font-weight|semi-bold"
				}
			}
		},
		"blocks": {}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": []
}
